<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- clear inherited machine/user-level sources so only the sources below are trusted -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- every package resolves only from nuget.org; this blocks dependency-confusion attacks where a
         malicious public package is published under the name of an internal one -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- if PicNet ever publishes internal packages, add the private feed above and route its prefix here:
    <packageSource key="picnet-internal">
      <package pattern="PicNet.*" />
    </packageSource>
    -->
  </packageSourceMapping>
</configuration>
